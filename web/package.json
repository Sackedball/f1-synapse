{
  "name": "f1-synapse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test a11y.spec.ts",
    "e2e:soak": "playwright test soak.spec.ts",
    "e2e:responsive": "playwright test responsive.spec.ts",
    "e2e:visual": "playwright test visual.spec.ts",
    "capture:blackbook": "playwright test capture-blackbook.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "gen:types": "openapi-typescript ./openapi.json -o ./src/api/types.gen.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.2",
    "@fontsource/titillium-web": "^5.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "dockview-react": "^8.4.0",
    "html2canvas": "^1.4.1",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "lucide-react": "^0.475.0",
    "pixi.js": "^8.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0",
    "react-router-dom": "^7.2.0",
    "sonner": "^2.0.8",
    "symbol-tree": "^3.2.4",
    "tailwind-merge": "^3.0.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.5.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
