{
  "framework": "vite",
  "buildCommand": "cd web && npm install && npm run build:demo",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!demo/|assets/|fonts/).*)",
      "destination": "/index.html"
    }
  ]
}
